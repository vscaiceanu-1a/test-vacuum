{
  "$schema": "https://raw.githubusercontent.com/AmadeusITGroup/otter/refs/heads/feature/openapi-solution/packages/@ama-openapi/core/schemas/manifest.schema.json",
  "name": "@test/sdk",
  "preferUnplugged": true,
  "version": "0.0.0-placeholder",
  "description": "My Specification description",
  "main": "bundle/specification.yaml",
  "files": [
    "bundle",
    "models",
    "ama-openapi.manifest.json",
    "ama-openapi.manifest.yaml",
    "ama-openapi.manifest.yml",
    "openapi.manifest.json",
    "openapi.manifest.yaml",
    "openapi.manifest.yml",
    "package.json"
  ],
  "readme": "README.md",
  "scripts": {
    "lint": "npm run build && redocly lint bundle/specification.yaml",
    "lint:source": "redocly lint models/**/*.yaml apis/**/*.yaml",
    "build": "redocly bundle",
    "build:plugin": "tsc",
    "retrieve-externals": "ama-openapi install",
    "watch:retrieve-externals": "ama-openapi watch",
    "postinstall": "ama-openapi install",
    "dashboard": "vacuum dashboard bundle/specification.yaml"
  },
  "dependencies": {
    "@ama-openapi/cli": "~0.0.0-placeholder.10"
  },
  "devDependencies": {
    "@ama-openapi/redocly-plugin": "~0.0.0-placeholder.10",
    "@redocly/cli": "~2.11.0",
    "@redocly/openapi-core": "^2.11.1",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  },
  "exports": {
    "./package.json": "./package.json",
    "./models/*": "./models/*",
    "./bundle/*": "./bundle/*",
    ".": {
      "module": "./bundle/specification.yaml",
      "default": "./bundle/specification.yaml"
    }
  },
  "engines": {
    "node": "^20.19.0 || ^22.17.0 || ^24.0.0"
  }
}
